# Set AUTOSERVICE_DATA_DIR to an absolute path for a separate demo DB.
# AUTOSERVICE_DATA_DIR=
# Legacy searches can be configured separately. The workspace uses demo sources.
SUPPLIER_ADAPTER=mock
LLM_PROVIDER=off
VIN_DECODE_LIVE=0

# Set both for HTTPS shared access. Supply credential values outside the repository.
# AUTOSERVICE_USERS=
# AUTOSERVICE_SESSION_KEY=
